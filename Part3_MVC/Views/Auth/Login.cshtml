@model POE_P3_WEB.Models.ViewsModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login - RaceDay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center py-4" style="height: 100vh;">
    <div class="container" style="max-width: 400px;">
        <div class="card p-4 shadow-sm">
            <h3 class="text-center mb-3">RaceDay Login</h3>
            @if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger mb-2"></div>
                <div class="mb-3">
                    <label>Email address</label>
                    <input asp-for="Email" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label>Password</label>
                    <input asp-for="Password" type="password" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>
            <div class="text-center mt-3">
                <a asp-action="Register">Don't have an account? Register</a>
            </div>
        </div>
    </div>
</body>
</html>
