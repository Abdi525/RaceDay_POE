@model POE_P3_WEB.Models.ViewsModels.EventTypeViewModel
@{
    ViewData["Title"] = "Add Event Category";
}
<h2>Add Event Category</h2>
<form asp-action="AddCategory" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <input asp-for="EventId" type="hidden" />
    <div class="mb-3">
        <label asp-for="EventTypeName" class="form-label">Category name</label>
        <input asp-for="EventTypeName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="DistanceKM" class="form-label">Distance (KM)</label>
        <input asp-for="DistanceKM" type="number" min="0.1" step="0.1" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="EntranceFee" class="form-label">Entrance fee</label>
        <input asp-for="EntranceFee" type="number" min="0" step="0.01" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="MaxParticipants" class="form-label">Maximum participants</label>
        <input asp-for="MaxParticipants" type="number" min="1" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Save Category</button>
    <a asp-action="Dashboard" class="btn btn-secondary">Cancel</a>
</form>
